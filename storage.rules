rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Allow authenticated users to upload partner documents
    match /partner_docs/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Public read access for product images
    match /product_images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Default rule (deny all else) or adjust as needed
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
